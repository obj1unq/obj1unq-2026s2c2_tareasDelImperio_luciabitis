import imperio.*
import habitantes.*

describe "Imperio Inca" {

     const siembraDePapa = new SiembraEnElValle(esfuerzo= 1.2, epoca= epocaSeca)
     const siembraDeMaiz = new SiembraEnTerraza(esfuerzo= 1.5) 

     const rutaTamboCentral = new Mensaje()
     const caminoDelSapaInca = new MensajeImperial()

  test "Tareas de siembra" {
     assert.equals(180, siembraDePapa.recursosProducidos(4))
     assert.equals(420, siembraDePapa.recursosProducidos(10))
     assert.equals(900, siembraDeMaiz.recursosProducidos(5))
     assert.equals(1125, siembraDeMaiz.recursosProducidos(7))
  }
  test "tareas de mensajes" {
    assert.equals(210, rutaTamboCentral.recursosProducidos(4))
    assert.equals(525, rutaTamboCentral.recursosProducidos(10))
    assert.equals(210, rutaTamboCentral.recursosProducidos(4))
    assert.equals(810, caminoDelSapaInca.recursosProducidos(10))
  }


}